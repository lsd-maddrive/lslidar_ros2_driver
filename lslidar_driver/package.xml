<?xml version="1.0"?>
<package format="3">
  <name>lslidar_ch_driver</name>  
  <version>1.0.0</version>
  <description>ROS 2 driver for Lslidar CH series devices</description>
  <license>BSD</license>

  <maintainer email="leti-email@example.com">MADDRIVE</maintainer>
  <author>leti sau maddrive</author>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcap</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>message_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>